{
  "name": "dsh-agent-status",
  "version": "0.2.0",
  "type": "module",
  "description": "Agent 进度：会话标题栏胶囊 + 屏幕右下角常驻置顶窗口（独立桌面窗口，永远在最上层）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-status",
    "progress",
    "status-bar",
    "session",
    "tool-call",
    "ui",
    "overlay",
    "always-on-top",
    "hud",
    "floating-window"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "desktop-hud.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0"
  },
  "author": "mdktelmdktel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdktelmdktel/dsh-agent-status.git"
  },
  "bugs": {
    "url": "https://github.com/mdktelmdktel/dsh-agent-status/issues"
  },
  "homepage": "https://github.com/mdktelmdktel/dsh-agent-status#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
